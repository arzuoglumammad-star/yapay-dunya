{
  "name": "Yapay Dünya Remote Linux",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "forwardPorts": [
    8787,
    8790
  ],
  "portsAttributes": {
    "8787": {
      "label": "Yapay Dünya Linux Center",
      "protocol": "http",
      "onAutoForward": "notify"
    },
    "8790": {
      "label": "Yapay Dünya World Engine",
      "protocol": "http",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "bash linux/system-check.sh"
}
